# The connected Supabase project exposes the LocalLens PostgreSQL data through this Node.js API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_project_key
PORT=4000
# Comma-separated origins allowed to call this API from the browser.
CORS_ORIGIN=http://localhost:8080
