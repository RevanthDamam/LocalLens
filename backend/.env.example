# The PostgreSQL database used by the LocalLens Node.js API.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/locallens
# Use true when the database provider requires TLS.
DATABASE_SSL=false
# Generate a random value with at least 32 characters for production.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
PORT=4000
# Comma-separated origins allowed to call this API from the browser.
CORS_ORIGIN=http://localhost:8080
