# Leave blank in local development to use Vite's /api proxy to the backend service.
# For a separately hosted production API, use a complete URL such as https://api.example.com/api.
VITE_API_BASE_URL=

# Optional: Ollama URL for the CornerStores assistant. It defaults to the same-origin development proxy.
# VITE_OLLAMA_URL=http://localhost:11434

